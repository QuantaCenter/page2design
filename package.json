{
  "name": "page-to-design",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run build:core && concurrently -k -n core,api,web \"tsc -b packages/core/tsconfig.json --watch --preserveWatchOutput\" \"node scripts/dev-api.mjs\" \"vite --host 127.0.0.1\"",
    "build:core": "bun run --cwd packages/core build",
    "build": "bun run build:core && tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "bun run build:core && bun run --cwd packages/core test && node --import tsx --test tests/*.test.ts",
    "test:package": "node scripts/test-core-package.mjs",
    "pack:core": "npm pack --workspace @page-to-design/core --pack-destination artifacts",
    "test:e2e": "playwright test",
    "profile:preview": "node --import tsx scripts/profile-preview.mts",
    "setup:browser": "playwright install chromium",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "bun run build:core && oxlint --deny-warnings .",
    "lint:fix": "bun run build:core && oxlint --fix --deny-warnings .",
    "typecheck": "bun run build:core && tsc --noEmit && tsc -p packages/core/tsconfig.test.json",
    "check": "bun run format:check && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@page-to-design/core": "*",
    "express": "^5.1.0",
    "konva": "^10.0.0",
    "lucide-react": "^0.577.0",
    "playwright": "^1.58.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "engines": {
    "bun": ">=1.2.1",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.2.1"
}
