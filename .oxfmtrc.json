{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/*.tsbuildinfo",
    "artifacts/**",
    "test-results/**",
    "playwright-report/**",
    "tests/fixtures/**",
    "public/**",
    "packages/core/examples/**"
  ],
  "tabWidth": 2
}
