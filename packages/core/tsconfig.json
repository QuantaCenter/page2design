{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "noEmitOnError": true,
    "composite": true,
    "tsBuildInfoFile": "node_modules/.cache/core.tsbuildinfo",
    "rootDir": "src",
    "outDir": "dist",
    "types": []
  },
  "include": ["src"],
  "watchOptions": {
    "watchFile": "fixedPollingInterval",
    "watchDirectory": "fixedPollingInterval",
    "fallbackPolling": "fixedInterval"
  }
}
